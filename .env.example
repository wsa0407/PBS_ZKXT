# B.AI 模型网关（必填）
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1

# 对话和拆解默认使用的模型，可在页面上切换
APP_MODEL=gpt-5.4-mini

# 向量检索；EMBED_BASE_URL 留空时走 B.AI 网关，APP_EMBED=off 强制使用关键词检索
EMBED_MODEL=text-embedding-3-small
EMBED_BASE_URL=
EMBED_API_KEY=
APP_EMBED=

# 缓存相同提示词的模型结果，仅用于演示彩排
APP_LLM_CACHE=off

# 服务监听地址与数据库位置（默认 127.0.0.1:8765，app/data/app.db）
HOST=127.0.0.1
PORT=8765
APP_DB=
