# B.AI 模型网关（必填）
BAI_API_KEY=
BAI_BASE_URL=https://api.b.ai/v1

# B.AI 直连超时时，可配置现有 HTTP 代理；端口以本机代理软件设置为准
# macOS 系统代理不会自动传给 Node.js 进程
# HTTPS_PROXY=http://127.0.0.1:7897

# 对话和拆解默认使用的模型，可在页面上切换
APP_MODEL=gpt-5.4-mini

# 向量检索；EMBED_BASE_URL 留空时走 B.AI 网关，APP_EMBED=off 强制使用关键词检索
# openai：OpenAI兼容接口；dashscope：阿里云原生接口
EMBED_PROVIDER=openai
# dashscope 的 EMBED_BASE_URL 填工作空间 /api/v1 根地址或完整原生接口地址
# 例如：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1
EMBED_MODEL=text-embedding-3-small
EMBED_BASE_URL=
EMBED_API_KEY=
APP_EMBED=

# 缓存相同提示词的模型结果，仅用于演示彩排
APP_LLM_CACHE=off

# 服务监听地址与数据库位置（默认 127.0.0.1:8765，app/data/app.db）
HOST=127.0.0.1
PORT=8765
APP_DB=
